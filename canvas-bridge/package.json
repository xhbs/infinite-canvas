{
  "name": "@local/canvas-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent local bridge for Infinite Canvas and MCP clients.",
  "scripts": {
    "start": "node bridge-start.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mcp": "./mcp.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bridge-start.mjs",
    "mcp.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
